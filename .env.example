# Copy to .env. popcorn reads it at startup; the real environment wins.

# Answerers and grader. Answerers whose key is missing are skipped (grading needs Anthropic).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Comma-separated bearer tokens for the UI and API (so one can be rotated at a time).
# Required to listen beyond 127.0.0.1. openssl rand -hex 32
POPCORN_TOKENS=

# Optional paths.
# POPCORN_CONFIG=../your-config/popcorn.toml   default: the example; prompt sets are read from prompt-sets/ beside it
# POPCORN_PROMPT_SETS=../your-config/prompt-sets
# POPCORN_CONFIG_REV=abc123   the config commit, when the config is deployed without its .git
# POPCORN_DATA_DIR=data
# POPCORN_ADDR=127.0.0.1:3000
# POPCORN_DEBUG=1
