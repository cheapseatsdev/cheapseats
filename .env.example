# Copy to .env. cheapseats reads it at startup; the real environment wins.
# .env holds keys and settings only. Anything that sends requests elsewhere, runs code or decides
# who signs in is ignored here with a warning and must be set in the real environment:
# CHEAPSEATS_*_BASE_URL, *_PROXY, SSL_CERT_FILE, SSL_CERT_DIR, NODE_EXTRA_CA_CERTS,
# CHEAPSEATS_AUTH_HEADER, CHEAPSEATS_ALLOWED_EMAILS, CHEAPSEATS_CLI_ENV, and startup variables
# such as LD_*, DYLD_*, NODE_OPTIONS, PYTHON*, PERL5*, RUBYOPT and BASH_ENV. (Run in a config
# checkout, its .env could otherwise send your real keys to someone else.) CHEAPSEATS_TOKENS below
# is allowed: check that a .env you didn't write doesn't set one before serving beyond localhost.

# Answerers and grader. Answerers whose key is missing are skipped (grading needs Anthropic).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional providers (docs/optional-providers.md), only with [typesafe] or [exa] in the config.
# Each key can instead be a key-adding proxy: CHEAPSEATS_TYPESAFE_BASE_URL / CHEAPSEATS_EXA_BASE_URL.
# TYPESAFE_API_KEY=
# EXA_API_KEY=

# Comma-separated bearer tokens for the UI and API (so one can be rotated at a time).
# Required to listen beyond 127.0.0.1. openssl rand -hex 32
CHEAPSEATS_TOKENS=

# Optional paths.
# CHEAPSEATS_CONFIG=../your-config/cheapseats.toml   default: the example; prompt sets are read from prompt-sets/ beside it
# CHEAPSEATS_PROMPT_SETS=../your-config/prompt-sets
# CHEAPSEATS_CONFIG_REV=abc123   the config commit, when the config is deployed without its .git
# CHEAPSEATS_DATA_DIR=data
# CHEAPSEATS_ADDR=127.0.0.1:3000
# CHEAPSEATS_DEBUG=1
